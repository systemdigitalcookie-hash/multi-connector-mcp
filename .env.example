# Random secret that forms part of the connector URL. Generate with: openssl rand -hex 32
MCP_SECRET=

# One token per client workspace. The part after NOTION_TOKEN_ becomes the client id ("acme").
NOTION_TOKEN_ACME=ntn_xxx
NOTION_NAME_ACME=Acme Corp

NOTION_TOKEN_GLOBEX=ntn_yyy
NOTION_NAME_GLOBEX=Globex Inc
